# SEO / metadata
SITE_URL=https://www.voquarn.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Database
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Auth
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AUTH_TRUST_HOST=true
ADMIN_EMAIL=admin@voquarn.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Contact form / email
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@voquarn.com
CONTACT_FROM_EMAIL=Voquarn Code <hello@voquarn.com>

# Ads / Pixel tracking (client-side only; leave blank to disable)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
