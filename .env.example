# SEO / metadata
SITE_URL=https://www.voquarn.com
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
IMAGE_REMOTE_HOSTS=images.unsplash.com,api.dicebear.com

# Database
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Recommended in production: restricted runtime role provisioned with
# `npm run db:provision:runtime-role`. DATABASE_URL remains the migration owner.
APP_DATABASE_URL=
APP_DATABASE_PASSWORD=

# Media uploads (automatically added when a Vercel Blob store is connected)
BLOB_READ_WRITE_TOKEN=

# Auth
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AUTH_TRUST_HOST=true
ADMIN_EMAIL=admin@voquarn.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Contact form / email
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@voquarn.com
CONTACT_FROM_EMAIL=Voquarn Code <hello@voquarn.com>
CRON_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Analytics / Pixel tracking (client-side only; leave blank to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
